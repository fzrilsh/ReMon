# ─────────────────────────────────────────────
# ReMon — Environment Configuration
# Copy this file to .env and fill in values
# ─────────────────────────────────────────────

# Environment: development | production
NODE_ENV=development

# Port for Express server
PORT=3000

# ─── Database ─────────────────────────────────
# PostgreSQL connection string (Prisma format)
# URL-encode special characters in password:
#   ] → %5D    ? → %3F    , → %2C    } → %7D
DATABASE_URL=postgresql://user:password@host:5432/database_name

# ─── Session ──────────────────────────────────
# Random string for signing session cookies
# Generate with: openssl rand -hex 32
SESSION_SECRET=change-this-to-a-random-secret-string

# ─── DeepSeek AI ──────────────────────────────
# API key from https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# ─── App Path ─────────────────────────────────
# Base path (set to /ReMon for cPanel, / for dev root)
APP_BASE_PATH=/ReMon

# ─── Uploads ──────────────────────────────────
# Directory for uploaded receipt/proof images (relative to project root)
UPLOAD_DIR=public/uploads
