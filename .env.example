# ─────────────────────────────────────────────
# ReMon — Environment Configuration
# Copy this file to .env and fill in values
# ─────────────────────────────────────────────

# Environment: development | production
NODE_ENV=development

# Port for Express server
PORT=3000

# ─── Database ─────────────────────────────────
# Development (Docker):
DATABASE_URL=postgresql://remon_user:remon_dev_pass@localhost:5432/remon_dev

# Production (cPanel — uncomment & adjust):
# URL-encode special chars in password: ] → %5D  ? → %3F  , → %2C  } → %7D
# DATABASE_URL=postgresql://user:password@localhost:5436/database_name

# ─── Session ──────────────────────────────────
# Random string for signing session cookies
# Generate with: openssl rand -hex 32
SESSION_SECRET=change-this-to-a-random-secret-string

# ─── AI ───────────────────────────────────────
# API key for the AI provider
AI_API_KEY=sk-your-api-key

# AI endpoint & model (defaults work out of the box)
AI_BASE_URL=https://your-provider
AI_MODEL=your-model

# ─── App Path ─────────────────────────────────
# Base path (set to /ReMon for cPanel, / for dev root)
APP_BASE_PATH=/ReMon

# ─── Uploads ──────────────────────────────────
# Directory for uploaded receipt/proof images (relative to project root)
UPLOAD_DIR=public/uploads
