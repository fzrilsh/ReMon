<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - ReMon</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="<%= basePath %>/css/app.css">
  <link rel="manifest" href="<%= basePath %>/manifest.json">
  <meta name="theme-color" content="#000000">
</head>
<body class="auth-page">
  <main class="auth-container">
    <div class="auth-card">
      <div class="auth-header">
        <h1 class="auth-logo">ReMon</h1>
        <p class="auth-tagline">Buat akun untuk mulai mencatat</p>
      </div>

      <form action="<%= basePath %>/auth/register" method="POST" class="auth-form" novalidate>
        <div class="form-group">
          <label for="name" class="form-label">Nama</label>
          <input
            type="text"
            id="name"
            name="name"
            class="form-input <%= errors && errors.name ? 'form-input--error' : '' %>"
            placeholder="Masukkan nama lengkap"
            value="<%= oldInput.name || '' %>"
            required
            autofocus
          />
          <% if (errors && errors.name) { %>
            <span class="form-error"><%= errors.name[0] %></span>
          <% } %>
        </div>

        <div class="form-group">
          <label for="email" class="form-label">Email</label>
          <input
            type="email"
            id="email"
            name="email"
            class="form-input <%= errors && errors.email ? 'form-input--error' : '' %>"
            placeholder="Masukkan email"
            value="<%= oldInput.email || '' %>"
            required
          />
          <% if (errors && errors.email) { %>
            <span class="form-error"><%= errors.email[0] %></span>
          <% } %>
        </div>

        <div class="form-group">
          <label for="password" class="form-label">Password</label>
          <input
            type="password"
            id="password"
            name="password"
            class="form-input <%= errors && errors.password ? 'form-input--error' : '' %>"
            placeholder="Minimal 6 karakter"
            required
          />
          <% if (errors && errors.password) { %>
            <span class="form-error"><%= errors.password[0] %></span>
          <% } %>
        </div>

        <button type="submit" class="btn btn-primary btn-full">
          Daftar
        </button>
      </form>

      <p class="auth-footer-text">
        Sudah punya akun?
        <a href="<%= basePath %>/auth/login" class="auth-link">Masuk</a>
      </p>
    </div>
  </main>
</body>
</html>
