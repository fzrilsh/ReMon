<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - ReMon</title>
  <link rel="stylesheet" href="<%= basePath %>/css/app.css">
</head>
<body style="background:#000000;min-height:100vh;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:16px;padding:20px;text-align:center;">
  <h1 style="font-size:72px;color:#ff4c00;margin:0;">Oops!</h1>
  <h2 style="color:#ffffff;"><%= title %></h2>
  <p style="color:#403842;max-width:400px;"><%= message %></p>
  <a href="<%= basePath %>/auth/login" style="background:#ff4c00;color:#fff;padding:12px 24px;border-radius:12px;text-decoration:none;font-weight:600;">
    Kembali ke Beranda
  </a>
  <% if (error && error.stack) { %>
    <details style="margin-top:20px;text-align:left;max-width:600px;">
      <summary style="cursor:pointer;color:#403842;font-weight:600;">Detail Error</summary>
      <pre style="font-size:12px;color:#403842;overflow-x:auto;"><%= error.stack %></pre>
    </details>
  <% } %>
</body>
</html>
