<%- include("../partials/header") %>
<div style="max-width:560px;">
  <h2 style="font-size:24px;font-weight:700;color:#150c18;margin-bottom:4px;">Buat Split Bill</h2>
  <p style="font-size:14px;color:#403842;margin-bottom:24px;">Pilih pengeluaran dan masukkan teman-teman yang ikut patungan</p>

  <% if (errors && errors.general) { %>
    <div class="card" style="margin-bottom:16px;border-left:4px solid #c0392b;padding:12px 16px;">
      <p style="font-size:14px;color:#c0392b;"><%= errors.general[0] %></p>
    </div>
  <% } %>

  <form action="<%= basePath %>/split-bills" method="POST" class="card" novalidate>
    <div class="form-group">
      <label for="transactionId" class="form-label">Pilih Pengeluaran</label>
      <select id="transactionId" name="transactionId" class="form-input <%= errors && errors.transactionId ? 'form-input--error' : '' %>" required>
        <option value="">Pilih transaksi...</option>
        <% if (typeof transactions !== 'undefined' && transactions.length > 0) { %>
          <% transactions.forEach(function(t) { %>
            <option value="<%= t.id %>" <%= oldInput.transactionId === t.id ? 'selected' : '' %>>
              Rp <%= Number(t.amount).toLocaleString('id-ID') %> — <%= t.description %> (<%= new Date(t.date).toLocaleDateString('id-ID') %>)
            </option>
          <% }); %>
        <% } %>
      </select>
      <% if (errors && errors.transactionId) { %><span class="form-error"><%= errors.transactionId[0] %></span><% } %>
    </div>

    <div class="form-group">
      <label for="participants" class="form-label">Nama Peserta</label>
      <textarea id="participants" name="participants" class="form-input <%= errors && errors.participants ? 'form-input--error' : '' %>" rows="4" placeholder="Tulis nama per baris atau pisah dengan koma&#10;Contoh:&#10;Juan&#10;Kent&#10;Rooney" required><%= oldInput.participants || '' %></textarea>
      <span class="form-error" style="color:#403842;font-weight:400;">Pisah dengan baris baru atau koma. Nama kamu akan diisi otomatis.</span>
      <% if (errors && errors.participants) { %><span class="form-error"><%= errors.participants[0] %></span><% } %>
    </div>

    <div class="form-group">
      <div class="card" style="background:#f8f8f8;padding:12px 16px;">
        <p style="font-size:13px;color:#403842;">💡 Jumlah akan dibagi rata ke semua peserta. Link pembayaran akan digenerate otomatis setelah dibuat.</p>
      </div>
    </div>

    <div style="display:flex;gap:8px;">
      <a href="<%= basePath %>/split-bills" class="btn btn-secondary">Batal</a>
      <button type="submit" class="btn btn-primary">Buat Split Bill</button>
    </div>
  </form>
</div>
<%- include("../partials/footer") %>
