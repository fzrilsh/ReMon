<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Bayar Split Bill — ReMon</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="<%= basePath %>/css/app.css">
  <meta name="theme-color" content="#000000">
</head>
<body style="background:#000000;min-height:100vh;display:flex;align-items:center;justify-content:center;padding:16px;">
  <div style="width:100%;max-width:440px;">

    <% if (typeof paid !== 'undefined' && paid) { %>
      <!-- Success State -->
      <div class="card" style="text-align:center;padding:32px;">
        <div style="font-size:64px;margin-bottom:16px;">✅</div>
        <h2 style="font-size:24px;color:#150c18;margin-bottom:8px;">Pembayaran Terverifikasi!</h2>
        <p style="font-size:14px;color:#403842;margin-bottom:4px;"><strong><%= paidParticipant %></strong> telah membayar</p>
        <p style="font-size:24px;font-weight:700;color:#2d7d2d;margin-bottom:16px;">Rp <%= paidAmount %></p>
        <p style="font-size:13px;color:#403842;">Progress: <%= progress %> peserta sudah bayar</p>
      </div>
    <% } else if (typeof splitBill !== 'undefined' && splitBill.id) { %>
      <!-- Payment Form -->
      <div style="text-align:center;margin-bottom:24px;">
        <h1 style="font-size:30px;font-weight:700;color:#ffffff;">💰 Split Bill</h1>
      </div>

      <div class="card" style="margin-bottom:16px;">
        <h3 style="font-size:16px;margin-bottom:4px;"><%= splitBill.transaction.description %></h3>
        <p style="font-size:13px;color:#403842;">
          Total: Rp <%= Number(splitBill.totalAmount).toLocaleString('id-ID') %>
        </p>
      </div>

      <% if (errors && errors.general) { %>
        <div class="card" style="margin-bottom:16px;border-left:4px solid #c0392b;padding:12px;">
          <p style="font-size:14px;color:#c0392b;"><%= errors.general %></p>
        </div>
      <% } %>

      <form action="<%= basePath %>/split/<%= splitBill.slug %>/pay" method="POST" enctype="multipart/form-data" class="card" novalidate>
        <div class="form-group">
          <label for="name" class="form-label">Bayar sebagai</label>
          <select id="name" name="name" class="form-input" required>
            <option value="">Pilih nama kamu...</option>
            <% splitBill.participants.forEach(function(p) { %>
              <option value="<%= p.name %>" <%= p.status === 'PAID' ? 'disabled' : '' %>>
                <%= p.name %> — Rp <%= Number(p.amount).toLocaleString('id-ID') %>
                <%= p.status === 'PAID' ? '(Sudah bayar)' : '' %>
              </option>
            <% }) %>
          </select>
          <% if (errors && errors.name) { %><span class="form-error"><%= errors.name[0] %></span><% } %>
        </div>

        <div class="form-group">
          <label for="proof" class="form-label">Upload Bukti Transfer</label>
          <div onclick="document.getElementById('proof').click()" style="border:2px dashed #403842;border-radius:12px;padding:24px;text-align:center;cursor:pointer;">
            <div style="font-size:36px;margin-bottom:8px;">📎</div>
            <p style="font-size:14px;color:#403842;">Klik untuk upload screenshot transfer</p>
            <input type="file" id="proof" name="proof" accept="image/jpeg,image/png,image/webp" required style="display:none;" onchange="document.getElementById('proof_name').textContent=this.files[0].name" />
            <p id="proof_name" style="font-size:13px;color:#150c18;margin-top:8px;font-weight:600;"></p>
          </div>
          <% if (errors && errors.proof) { %><span class="form-error"><%= errors.proof %></span><% } %>
        </div>

        <button type="submit" class="btn btn-primary btn-full">Kirim Pembayaran</button>
      </form>

      <p style="text-align:center;font-size:12px;color:#403842;margin-top:16px;">
        Pembayaran akan diverifikasi oleh AI. Pastikan upload bukti transfer yang valid.
      </p>
    <% } else { %>
      <!-- Error state -->
      <div class="card" style="text-align:center;padding:32px;">
        <div style="font-size:64px;margin-bottom:16px;">🔗</div>
        <h2 style="font-size:20px;color:#150c18;margin-bottom:8px;">Link Tidak Valid</h2>
        <p style="font-size:14px;color:#403842;">Split bill tidak ditemukan atau sudah tidak aktif</p>
      </div>
    <% } %>

  </div>
</body>
</html>
