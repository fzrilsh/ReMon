<% if (!locals.isPartial) { %><%- include("../partials/header") %><% } %>
<div id="appContent" class="animate-in fade-in duration-300">
  <div class="max-w-[560px]">
    <h2 class="text-2xl font-bold text-gcore-900 mb-1">Catat Hutang</h2>
    <p class="text-gsm text-gcore-400 mb-6">Apakah kamu hutang ke teman atau teman hutang ke kamu?</p>

    <% if (errors && errors.general) { %>
      <div class="bg-white border-l-4 border-expense rounded-gsm p-3 mb-4">
        <p class="text-gsm text-expense"><i class="fas fa-exclamation-circle"></i>
          <%= errors.general[0] %>
        </p>
      </div>
      <% } %>

        <form action="<%= basePath %>/debts" method="POST" class="bg-white border-2 border-gray-200 rounded-gsm p-6"
          novalidate>
          <div class="mb-4">
            <label class="block text-gsm font-semibold text-gcore-900 mb-1.5">Arah Hutang</label>
            <div class="flex gap-2">
              <label class="flex-1 cursor-pointer">
                <input type="radio" name="direction" value="I_OWE" <%=locals.oldInput?.direction==='I_OWE' ||
                  !locals.oldInput?.direction ? 'checked' : '' %>
                class="peer hidden"
                >
                <div
                  class="py-2.5 border-2 <%= locals.errors?.direction ? 'border-expense' : 'border-gcore-500' %> rounded-gsm text-center font-medium bg-white peer-checked:bg-gray-100 peer-checked:border-gcore-900 peer-checked:font-semibold transition-all duration-150">
                  <i class="fas fa-arrow-right text-expense"></i> Saya hutang dia
                </div>
              </label>

              <label class="flex-1 cursor-pointer">
                <input type="radio" name="direction" value="THEY_OWE" <%=locals.oldInput?.direction==='THEY_OWE'
                  ? 'checked' : '' %>
                class="peer hidden"
                >
                <div
                  class="py-2.5 border-2 <%= locals.errors?.direction ? 'border-expense' : 'border-gcore-500' %> rounded-gsm text-center font-medium bg-white peer-checked:bg-gray-100 peer-checked:border-gcore-900 peer-checked:font-semibold transition-all duration-150">
                  <i class="fas fa-arrow-left text-income"></i> Dia hutang saya
                </div>
              </label>
            </div>
            <% if (errors && errors.direction) { %><span class="block text-gxs text-expense mt-1">
                <%= errors.direction[0] %>
              </span>
              <% } %>
          </div>

          <div class="mb-4">
            <label for="otherPersonName" class="block text-gsm font-semibold text-gcore-900 mb-1.5">Nama Orang</label>
            <input type="text" id="otherPersonName" name="otherPersonName"
              class="w-full px-3.5 py-2.5 font-sans text-sm font-medium text-gcore-900 bg-white border-2 <%= errors && errors.otherPersonName ? 'border-expense' : 'border-gray-200' %> rounded-gsm focus:outline-none focus:border-gcore-accent transition-colors"
              placeholder="Nama teman / kenalan" value="<%= oldInput.otherPersonName || '' %>" required />
            <% if (errors && errors.otherPersonName) { %><span class="block text-gxs text-expense mt-1">
                <%= errors.otherPersonName[0] %>
              </span>
              <% } %>
          </div>

          <div class="mb-4">
            <label for="amount_display" class="block text-gsm font-semibold text-gcore-900 mb-1.5">Jumlah (Rp)</label>
            <input type="text" id="amount_display" inputmode="numeric"
              class="w-full px-3.5 py-2.5 font-sans text-sm font-medium text-gcore-900 bg-white border-2 <%= errors && errors.amount ? 'border-expense' : 'border-gray-200' %> rounded-gsm focus:outline-none focus:border-gcore-accent transition-colors"
              placeholder="0" required />
            <input type="hidden" id="amount" name="amount" value="<%= oldInput.amount || '' %>" />
            <% if (errors && errors.amount) { %><span class="block text-gxs text-expense mt-1">
                <%= errors.amount[0] %>
              </span>
              <% } %>
          </div>

          <div class="mb-4">
            <label for="description" class="block text-gsm font-semibold text-gcore-900 mb-1.5">Deskripsi</label>
            <input type="text" id="description" name="description"
              class="w-full px-3.5 py-2.5 font-sans text-sm font-medium text-gcore-900 bg-white border-2 <%= errors && errors.description ? 'border-expense' : 'border-gray-200' %> rounded-gsm focus:outline-none focus:border-gcore-accent transition-colors"
              placeholder="Mis: Bayarin makan" value="<%= oldInput.description || '' %>" required />
            <% if (errors && errors.description) { %><span class="block text-gxs text-expense mt-1">
                <%= errors.description[0] %>
              </span>
              <% } %>
          </div>

          <div class="mb-4">
            <label for="dueDate" class="block text-gsm font-semibold text-gcore-900 mb-1.5">Jatuh Tempo
              (opsional)</label>
            <input type="date" id="dueDate" name="dueDate"
              class="w-full px-3.5 py-2.5 font-sans text-sm font-medium text-gcore-900 bg-white border-2 border-gray-200 rounded-gsm focus:outline-none focus:border-gcore-accent transition-colors"
              value="<%= oldInput.dueDate || '' %>" />
            <span class="block text-gxs text-gcore-400 mt-1">Kosongkan jika tidak ada jatuh tempo</span>
          </div>

          <div class="flex gap-2 mt-4">
            <a href="<%= basePath %>/debts" class="btn btn-secondary">Batal</a>
            <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Simpan Hutang</button>
          </div>
        </form>
  </div>

  <script data-eval="true">
    (function() {
      const displayInput = document.getElementById('amount_display');
      const hiddenInput = document.getElementById('amount');
      if (!displayInput || !hiddenInput) return;

      function formatRupiah(value) {
        let number = value.toString().replace(/[^0-9]/g, '');
        if (!number) return '';
        return Number(number).toLocaleString('id-ID');
      }

      displayInput.addEventListener('input', function(e) {
        let rawValue = e.target.value.replace(/[^0-9]/g, '');
        hiddenInput.value = rawValue;
        e.target.value = formatRupiah(rawValue);
      });

      if (hiddenInput.value) {
        let val = Math.round(Number(hiddenInput.value)).toString();
        hiddenInput.value = val;
        displayInput.value = formatRupiah(val);
      }
    })();
  </script>

  </div>
<% if (!locals.isPartial) { %><%- include("../partials/footer") %><% } %>