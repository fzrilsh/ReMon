<%- include("../partials/header") %>

<div style="max-width:560px;">
  <h2 style="font-size:24px;font-weight:700;color:#150c18;margin-bottom:4px;">Catat Hutang</h2>
  <p style="font-size:14px;color:#403842;margin-bottom:24px;">
    Apakah kamu hutang ke teman atau teman hutang ke kamu?
  </p>

  <% if (errors && errors.general) { %>
    <div class="card" style="margin-bottom:16px;border-left:4px solid #c0392b;padding:12px;">
      <p style="font-size:14px;color:#c0392b;"><%= errors.general[0] %></p>
    </div>
  <% } %>

  <form action="<%= basePath %>/debts" method="POST" class="card" novalidate>
    <div class="form-group">
      <label class="form-label">Arah Hutang</label>
      <div style="display:flex;gap:8px;">
        <label style="flex:1;padding:10px;border:2px solid <%= errors && errors.direction ? '#c0392b' : '#403842' %>;border-radius:12px;text-align:center;cursor:pointer;background:<%= oldInput.direction === 'I_OWE' || !oldInput.direction ? '#f8f8f8' : '#fff' %>;font-weight:<%= oldInput.direction === 'I_OWE' || !oldInput.direction ? '600' : '400' %>;">
          <input type="radio" name="direction" value="I_OWE" <%= oldInput.direction === 'I_OWE' || !oldInput.direction ? 'checked' : '' %> style="display:none;" onchange="toggleDirection(this)">
          🇲🇨 Saya hutang dia
        </label>
        <label style="flex:1;padding:10px;border:2px solid <%= errors && errors.direction ? '#c0392b' : '#403842' %>;border-radius:12px;text-align:center;cursor:pointer;background:<%= oldInput.direction === 'THEY_OWE' ? '#f8f8f8' : '#fff' %>;font-weight:<%= oldInput.direction === 'THEY_OWE' ? '600' : '400' %>;">
          <input type="radio" name="direction" value="THEY_OWE" <%= oldInput.direction === 'THEY_OWE' ? 'checked' : '' %> style="display:none;" onchange="toggleDirection(this)">
          🇲🇨 Dia hutang saya
        </label>
      </div>
      <% if (errors && errors.direction) { %><span class="form-error"><%= errors.direction[0] %></span><% } %>
    </div>

    <div class="form-group">
      <label for="otherPersonName" class="form-label">Nama Orang</label>
      <input type="text" id="otherPersonName" name="otherPersonName" class="form-input <%= errors && errors.otherPersonName ? 'form-input--error' : '' %>" placeholder="Nama teman / kenalan" value="<%= oldInput.otherPersonName || '' %>" required />
      <% if (errors && errors.otherPersonName) { %><span class="form-error"><%= errors.otherPersonName[0] %></span><% } %>
    </div>

    <div class="form-group">
      <label for="amount" class="form-label">Jumlah (Rp)</label>
      <input type="number" id="amount" name="amount" class="form-input <%= errors && errors.amount ? 'form-input--error' : '' %>" placeholder="0" value="<%= oldInput.amount || '' %>" required step="0.01" min="0" />
      <% if (errors && errors.amount) { %><span class="form-error"><%= errors.amount[0] %></span><% } %>
    </div>

    <div class="form-group">
      <label for="description" class="form-label">Deskripsi</label>
      <input type="text" id="description" name="description" class="form-input <%= errors && errors.description ? 'form-input--error' : '' %>" placeholder="Mis: Bayarin makan, traktir kopi" value="<%= oldInput.description || '' %>" required />
      <% if (errors && errors.description) { %><span class="form-error"><%= errors.description[0] %></span><% } %>
    </div>

    <div class="form-group">
      <label for="dueDate" class="form-label">Jatuh Tempo (opsional)</label>
      <input type="date" id="dueDate" name="dueDate" class="form-input" value="<%= oldInput.dueDate || '' %>" />
      <span class="form-error" style="color:#403842;font-weight:400;">Kosongkan jika tidak ada jatuh tempo</span>
    </div>

    <div style="display:flex;gap:8px;margin-top:24px;">
      <a href="<%= basePath %>/debts" class="btn btn-secondary">Batal</a>
      <button type="submit" class="btn btn-primary">Simpan Hutang</button>
    </div>
  </form>
</div>

<script>
function toggleDirection(el) {
  var labels = document.querySelectorAll('input[name="direction"]');
  labels.forEach(function(input) {
    var label = input.closest('label');
    if (label) {
      label.style.background = input.checked ? '#f8f8f8' : '#fff';
      label.style.fontWeight = input.checked ? '600' : '400';
    }
  });
}
</script>

<%- include("../partials/footer") %>
