<% if (!locals.isPartial) { %><%- include("../partials/header") %><% } %>
<div id="appContent" class="animate-in fade-in duration-300">
<div class="flex flex-wrap items-start justify-between gap-3 mb-6">
  <div>
    <h2 class="text-2xl font-bold text-gcore-900">Hutang</h2>
    <p class="text-gsm text-gcore-400 mt-1">Catat dan pantau hutang piutang</p>
  </div>
  <a href="<%= basePath %>/debts/create" class="btn btn-primary"><i class="fas fa-plus"></i> Catat Hutang</a>
</div>

<!-- Summary Cards -->
<div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-5">
  <div class="bg-white border-2 border-gray-200 rounded-gsm p-4 border-l-4 border-l-expense">
    <p class="text-gxs font-semibold text-gcore-500 uppercase tracking-wide mb-1"><i class="fas fa-arrow-right text-expense"></i> Hutang Saya</p>
    <p class="text-xl font-bold text-expense">Rp <%= typeof totalIOwe !== 'undefined' ? Number(totalIOwe).toLocaleString('id-ID') : 0 %></p>
  </div>
  <div class="bg-white border-2 border-gray-200 rounded-gsm p-4 border-l-4 border-l-income">
    <p class="text-gxs font-semibold text-gcore-500 uppercase tracking-wide mb-1"><i class="fas fa-arrow-left text-income"></i> Dihutangi</p>
    <p class="text-xl font-bold text-income">Rp <%= typeof totalTheyOwe !== 'undefined' ? Number(totalTheyOwe).toLocaleString('id-ID') : 0 %></p>
  </div>
  <div class="bg-white border-2 border-gray-200 rounded-gsm p-4 border-l-4 <%= typeof netBalance !== 'undefined' && netBalance >= 0 ? 'border-l-income' : 'border-l-expense' %>">
    <p class="text-gxs font-semibold text-gcore-500 uppercase tracking-wide mb-1"><i class="fas fa-balance-scale"></i> Net Balance</p>
    <p class="text-xl font-bold <%= typeof netBalance !== 'undefined' && netBalance >= 0 ? 'text-income' : 'text-expense' %>">
      Rp <%= typeof netBalance !== 'undefined' ? Number(Math.abs(netBalance)).toLocaleString('id-ID') : 0 %>
      <span class="text-gxs font-medium"><%= typeof netBalance !== 'undefined' && netBalance >= 0 ? '(Dihutangi)' : '(Hutang)' %></span>
    </p>
  </div>
</div>

<!-- Active Debts -->
<% if (typeof active !== 'undefined' && active.length > 0) { %>
  <h3 class="font-semibold text-gcore-900 mb-3">Aktif (<%= active.length %>)</h3>
  <% active.forEach(function(d) { %>
    <div class="swipe-card-wrap bg-white border-2 border-gray-200 rounded-gsm mb-2 hover:bg-gray-50 transition-colors">
      <div class="swipe-content p-3">
        <div class="flex-1 min-w-0">
          <div class="flex flex-wrap items-center gap-2 mb-1">
            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-gxs font-semibold <%= d.direction === 'I_OWE' ? 'bg-red-100 text-red-800' : 'bg-green-100 text-green-800' %>">
              <i class="fas <%= d.direction === 'I_OWE' ? 'fa-arrow-right' : 'fa-arrow-left' %>"></i> <%= d.direction === 'I_OWE' ? 'Saya hutang' : 'Dia hutang' %>
            </span>
            <% if (d.dueDate) { %>
              <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-gxs font-semibold <%= new Date(d.dueDate) <= new Date() ? 'bg-red-100 text-red-800' : 'bg-yellow-100 text-yellow-800' %>">
                <i class="fas <%= new Date(d.dueDate) <= new Date() ? 'fa-exclamation-circle' : 'fa-calendar' %>"></i>
                <%= new Date(d.dueDate) <= new Date() ? 'Overdue' : new Date(d.dueDate).toLocaleDateString('id-ID') %>
              </span>
            <% } %>
          </div>
          <p class="font-semibold text-gcore-900"><%= d.otherPersonName %></p>
          <p class="text-gxs text-gcore-500 truncate"><%= d.description %></p>
        </div>
        <div class="text-right shrink-0 flex items-center gap-3">
          <div>
            <p class="text-lg font-bold text-gcore-900">Rp <%= Number(d.amount).toLocaleString('id-ID') %></p>
          </div>
          <div class="swipe-hint max-lg:flex hidden text-gcore-400 text-gxs"><i class="fas fa-chevron-left"></i></div>
          <div class="max-lg:hidden flex gap-1 items-center">
            <form action="<%= basePath %>/debts/<%= d.id %>/settle?_method=PATCH" method="POST" style="display:inline;">
              <button type="submit" class="swipe-btn swipe-btn-settle" title="Tandai Lunas" onclick="return confirm('Tandai lunas?')"><i class="fas fa-check"></i></button>
            </form>
            <form action="<%= basePath %>/debts/<%= d.id %>?_method=DELETE" method="POST" style="display:inline;">
              <button type="submit" class="swipe-btn swipe-btn-delete" title="Hapus" onclick="return confirm('Hapus?')"><i class="fas fa-trash"></i></button>
            </form>
          </div>
        </div>
      </div>
      <div class="swipe-actions">
        <form action="<%= basePath %>/debts/<%= d.id %>/settle?_method=PATCH" method="POST" style="display:flex;">
          <button type="submit" class="swipe-btn swipe-btn-settle" title="Tandai Lunas" onclick="return confirm('Tandai lunas?')"><i class="fas fa-check"></i></button>
        </form>
        <form action="<%= basePath %>/debts/<%= d.id %>?_method=DELETE" method="POST" style="display:flex;">
          <button type="submit" class="swipe-btn swipe-btn-delete" title="Hapus" onclick="return confirm('Hapus?')"><i class="fas fa-trash"></i></button>
        </form>
      </div>
    </div>
  <% }); %>
<% } else { %>
  <div class="bg-white border-2 border-gray-200 rounded-gsm p-8 text-center mb-4">
    <div class="text-3xl text-gcore-400 mb-3"><i class="fas fa-hand-holding-usd"></i></div>
    <h3 class="font-semibold text-gcore-900 mb-1">Tidak ada hutang aktif</h3>
    <p class="text-gsm text-gcore-400">Catat hutang pertama kamu</p>
  </div>
<% } %>

<!-- Settled Debts -->
<% if (typeof settled !== 'undefined' && settled.length > 0) { %>
  <h3 class="font-semibold text-gcore-900 mb-3 mt-6">Lunas (<%= settled.length %>)</h3>
  <% settled.forEach(function(d) { %>
    <div class="bg-white border-2 border-gray-200 rounded-gsm p-3 mb-2 opacity-60">
      <div class="flex items-center justify-between">
        <div>
          <p class="font-semibold text-gcore-900"><%= d.otherPersonName %></p>
          <p class="text-gxs text-gcore-500"><%= d.description %></p>
        </div>
        <p class="font-bold text-income"><i class="fas fa-check-circle"></i> Rp <%= Number(d.amount).toLocaleString('id-ID') %></p>
      </div>
    </div>
  <% }); %>
<% } %>

</div>
<% if (!locals.isPartial) { %><%- include("../partials/footer") %><% } %>
