<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;">
  <div>
    <h2 style="font-size:24px;font-weight:700;color:#150c18;">Transaksi</h2>
    <p style="font-size:14px;color:#403842;margin-top:4px;">Semua catatan pemasukan dan pengeluaran</p>
  </div>
  <div style="display:flex;gap:8px;">
    <a href="<%= basePath %>/transactions/receipt" class="btn btn-secondary">Upload Struk</a>
    <a href="<%= basePath %>/transactions/create" class="btn btn-primary">+ Transaksi Baru</a>
  </div>
</div>

<% if (typeof transactions !== 'undefined' && transactions.length > 0) { %>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Tanggal</th>
          <th>Tipe</th>
          <th>Deskripsi</th>
          <th>Kategori</th>
          <th>Jumlah</th>
          <th>Aksi</th>
        </tr>
      </thead>
      <tbody>
        <% transactions.forEach(function(t) { %>
          <tr>
            <td><%= new Date(t.date).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) %></td>
            <td>
              <span class="badge <%= t.type === 'INCOME' ? 'badge-success' : 'badge-danger' %>">
                <%= t.type === 'INCOME' ? 'Pemasukan' : 'Pengeluaran' %>
              </span>
            </td>
            <td><%= t.description %></td>
            <td><span class="badge badge-neutral"><%= t.category ? t.category.name : '-' %></span></td>
            <td style="font-weight:600;color:<%= t.type === 'INCOME' ? '#2d7d2d' : '#c0392b' %>;">
              Rp <%= Number(t.amount).toLocaleString('id-ID') %>
            </td>
            <td>
              <div style="display:flex;gap:4px;">
                <a href="<%= basePath %>/transactions/<%= t.id %>/edit" class="btn btn-ghost btn-sm">Edit</a>
                <form action="<%= basePath %>/transactions/<%= t.id %>?_method=DELETE" method="POST" onsubmit="return confirm('Hapus transaksi ini?')" style="display:inline;">
                  <button type="submit" class="btn btn-ghost btn-sm" style="color:#c0392b;">Hapus</button>
                </form>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } else { %>
  <div class="card" style="padding:48px;text-align:center;">
    <div style="font-size:48px;margin-bottom:16px;">📝</div>
    <h3 style="margin-bottom:8px;">Belum ada transaksi</h3>
    <p style="color:#403842;margin-bottom:24px;">Catat pemasukan atau pengeluaran pertama kamu</p>
    <a href="<%= basePath %>/transactions/create" class="btn btn-primary">Catat Transaksi</a>
  </div>
<% } %>
