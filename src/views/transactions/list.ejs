<%- include("../partials/header") %>

<div class="flex flex-wrap items-start justify-between gap-3 mb-6">
  <div>
    <h2 class="text-2xl font-bold text-gcore-900">Transaksi</h2>
    <p class="text-gsm text-gcore-400 mt-1">Semua catatan pemasukan dan pengeluaran</p>
  </div>
  <div class="flex gap-2 flex-wrap">
    <a href="<%= basePath %>/transactions/receipt" class="btn btn-secondary"><i class="fas fa-camera"></i> <span class="max-sm:hidden">Upload Struk</span></a>
    <a href="<%= basePath %>/transactions/create" class="btn btn-primary"><i class="fas fa-plus"></i> Baru</a>
  </div>
</div>

<% if (typeof transactions !== 'undefined' && transactions.length > 0) { %>
  <div class="table-wrap border-2 border-gray-200 rounded-gsm">
    <table class="w-full border-collapse">
      <thead>
        <tr>
          <th class="text-gxs font-semibold uppercase text-gcore-500 text-left p-2.5 border-b-2 border-gray-200 bg-gray-50 whitespace-nowrap">Tanggal</th>
          <th class="text-gxs font-semibold uppercase text-gcore-500 text-left p-2.5 border-b-2 border-gray-200 bg-gray-50 whitespace-nowrap max-sm:hidden">Tipe</th>
          <th class="text-gxs font-semibold uppercase text-gcore-500 text-left p-2.5 border-b-2 border-gray-200 bg-gray-50 whitespace-nowrap">Deskripsi</th>
          <th class="text-gxs font-semibold uppercase text-gcore-500 text-left p-2.5 border-b-2 border-gray-200 bg-gray-50 whitespace-nowrap max-sm:hidden">Kategori</th>
          <th class="text-gxs font-semibold uppercase text-gcore-500 text-left p-2.5 border-b-2 border-gray-200 bg-gray-50 whitespace-nowrap">Jumlah</th>
          <th class="text-gxs font-semibold uppercase text-gcore-500 text-left p-2.5 border-b-2 border-gray-200 bg-gray-50 whitespace-nowrap max-sm:hidden">Aksi</th>
        </tr>
      </thead>
      <tbody>
        <% transactions.forEach(function(t) { %>
          <tr class="hover:bg-gray-50">
            <td class="p-2.5 border-b border-gray-100 text-gsm text-gcore-900 whitespace-nowrap"><%= new Date(t.date).toLocaleDateString('id-ID', { day: 'numeric', month: 'short' }) %></td>
            <td class="p-2.5 border-b border-gray-100 max-sm:hidden">
              <span class="inline-flex items-center gap-1 <%= t.type === 'INCOME' ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' %> px-2 py-0.5 rounded-full text-gxs font-semibold">
                <i class="fas <%= t.type === 'INCOME' ? 'fa-arrow-up' : 'fa-arrow-down' %>"></i> <%= t.type === 'INCOME' ? 'Masuk' : 'Keluar' %>
              </span>
            </td>
            <td class="p-2.5 border-b border-gray-100 text-gsm text-gcore-900"><%= t.description %></td>
            <td class="p-2.5 border-b border-gray-100 max-sm:hidden"><span class="bg-gray-100 text-gray-600 px-2 py-0.5 rounded-full text-gxs font-semibold"><%= t.category ? t.category.name : '-' %></span></td>
            <td class="p-2.5 border-b border-gray-100 font-semibold whitespace-nowrap <%= t.type === 'INCOME' ? 'text-income' : 'text-expense' %>">Rp <%= Number(t.amount).toLocaleString('id-ID') %></td>
            <td class="p-2.5 border-b border-gray-100 max-sm:hidden">
              <div class="flex gap-1.5">
                <a href="<%= basePath %>/transactions/<%= t.id %>/edit" class="btn btn-ghost btn-sm"><i class="fas fa-edit"></i></a>
                <form action="<%= basePath %>/transactions/<%= t.id %>" method="POST"><input type="hidden" name="_method" value="DELETE" onsubmit="return confirm('Hapus?')" class="inline">
                  <button type="submit" class="btn btn-ghost btn-sm text-expense"><i class="fas fa-trash"></i></button>
                </form>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } else { %>
  <div class="bg-white border-2 border-gray-200 rounded-gsm p-12 text-center">
    <div class="text-4xl text-gcore-400 mb-4"><i class="fas fa-receipt"></i></div>
    <h3 class="font-semibold text-gcore-900 mb-2">Belum ada transaksi</h3>
    <p class="text-gsm text-gcore-400 mb-4">Catat pemasukan atau pengeluaran pertama kamu</p>
    <a href="<%= basePath %>/transactions/create" class="btn btn-primary"><i class="fas fa-plus"></i> Catat Transaksi</a>
  </div>
<% } %>

<%- include("../partials/footer") %>
