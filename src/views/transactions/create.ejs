<%- include("../partials/header") %>

<div class="max-w-[560px]">
  <h2 class="text-2xl font-bold text-gcore-900 mb-1">Tambah Transaksi</h2>
  <p class="text-gsm text-gcore-400 mb-6">Catat pemasukan atau pengeluaran baru</p>

  <% if (receiptData && receiptData.store_name) { %>
    <div class="bg-white border-2 border-gray-200 rounded-gsm p-4 mb-4 border-l-4 border-l-income bg-green-50">
      <p class="text-gsm font-semibold text-green-800"><i class="fas fa-check-circle text-income"></i> Data dari struk</p>
      <p class="text-gxs text-gcore-400 mt-1">
        Toko: <%= receiptData.store_name %> &middot; 
        Total: Rp <%= Number(receiptData.total_amount || 0).toLocaleString('id-ID') %>
      </p>
    </div>
  <% } %>

  <form action="<%= basePath %>/transactions" method="POST" class="bg-white border-2 border-gray-200 rounded-gsm p-6" novalidate>
    <div class="mb-4">
      <label class="block text-gsm font-semibold text-gcore-900 mb-1.5">Tipe</label>
      <div class="flex gap-2">
        <label class="flex-1 p-2.5 border-2 <%= errors && errors.type ? 'border-expense' : 'border-gray-200' %> rounded-gsm text-center cursor-pointer <%= oldInput.type === 'EXPENSE' || !oldInput.type ? 'bg-gray-100 font-semibold' : 'bg-white' %>">
          <input type="radio" name="type" value="EXPENSE" <%= oldInput.type === 'EXPENSE' || !oldInput.type ? 'checked' : '' %> class="hidden">
          <i class="fas fa-arrow-down text-expense"></i> Pengeluaran
        </label>
        <label class="flex-1 p-2.5 border-2 <%= errors && errors.type ? 'border-expense' : 'border-gray-200' %> rounded-gsm text-center cursor-pointer <%= oldInput.type === 'INCOME' ? 'bg-gray-100 font-semibold' : 'bg-white' %>">
          <input type="radio" name="type" value="INCOME" <%= oldInput.type === 'INCOME' ? 'checked' : '' %> class="hidden">
          <i class="fas fa-arrow-up text-income"></i> Pemasukan
        </label>
      </div>
      <% if (errors && errors.type) { %><span class="block text-gxs text-expense mt-1"><%= errors.type[0] %></span><% } %>
    </div>

    <div class="mb-4">
      <label for="amount" class="block text-gsm font-semibold text-gcore-900 mb-1.5">Jumlah (Rp)</label>
      <input type="number" id="amount" name="amount" class="w-full border-2 <%= errors && errors.amount ? 'border-expense' : 'border-gray-200' %> rounded-gsm px-4 py-2.5 text-gsm text-gcore-900 bg-white focus:outline-none focus:border-gcore-accent transition-colors" placeholder="0" value="<%= receiptData ? receiptData.total_amount : (oldInput.amount || '') %>" required step="0.01" min="0" />
      <% if (errors && errors.amount) { %><span class="block text-gxs text-expense mt-1"><%= errors.amount[0] %></span><% } %>
    </div>

    <div class="mb-4">
      <label for="description" class="block text-gsm font-semibold text-gcore-900 mb-1.5">Deskripsi</label>
      <input type="text" id="description" name="description" class="w-full border-2 <%= errors && errors.description ? 'border-expense' : 'border-gray-200' %> rounded-gsm px-4 py-2.5 text-gsm text-gcore-900 bg-white focus:outline-none focus:border-gcore-accent transition-colors" placeholder="Mis: Makan siang di warteg" value="<%= receiptData ? receiptData.store_name : (oldInput.description || '') %>" required />
      <% if (errors && errors.description) { %><span class="block text-gxs text-expense mt-1"><%= errors.description[0] %></span><% } %>
    </div>

    <div class="mb-4">
      <label for="categoryId" class="block text-gsm font-semibold text-gcore-900 mb-1.5">Kategori</label>
      <select id="categoryId" name="categoryId" class="w-full border-2 border-gray-200 rounded-gsm px-4 py-2.5 text-gsm text-gcore-900 bg-white focus:outline-none focus:border-gcore-accent transition-colors">
        <option value="">Pilih kategori (opsional)</option>
        <% if (typeof categories !== 'undefined') { %>
          <% categories.forEach(function(cat) { %>
            <option value="<%= cat.id %>" <%= oldInput.categoryId === cat.id ? 'selected' : '' %>><%= cat.name %></option>
          <% }); %>
        <% } %>
      </select>
    </div>

    <div class="mb-4">
      <label for="date" class="block text-gsm font-semibold text-gcore-900 mb-1.5">Tanggal</label>
      <input type="date" id="date" name="date" class="w-full border-2 border-gray-200 rounded-gsm px-4 py-2.5 text-gsm text-gcore-900 bg-white focus:outline-none focus:border-gcore-accent transition-colors" value="<%= new Date().toISOString().split('T')[0] %>" required />
    </div>

    <div class="flex gap-2 mt-6">
      <a href="<%= basePath %>/transactions" class="btn btn-secondary">Batal</a>
      <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Simpan</button>
    </div>
  </form>
</div>

<%- include("../partials/footer") %>
