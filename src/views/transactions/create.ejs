<%- include("../partials/header") %>
<div style="max-width:560px;">
  <h2 style="font-size:24px;font-weight:700;color:#150c18;margin-bottom:4px;">Tambah Transaksi</h2>
  <p style="font-size:14px;color:#403842;margin-bottom:24px;">Catat pemasukan atau pengeluaran baru</p>

  <% if (receiptData) { %>
    <div class="card" style="margin-bottom:20px;border-left:4px solid #2d7d2d;">
      <p style="font-size:14px;font-weight:600;color:#2d7d2d;">✅ Data dari struk berisi</p>
      <p style="font-size:13px;color:#403842;margin-top:4px;">
        Toko: <strong><%= receiptData.store_name || '-' %></strong> &middot; 
        Total: <strong>Rp <%= Number(receiptData.total_amount || 0).toLocaleString('id-ID') %></strong>
      </p>
    </div>
  <% } %>

  <form action="<%= basePath %>/transactions" method="POST" class="card" novalidate>
    <div class="form-group">
      <label class="form-label">Tipe</label>
      <div style="display:flex;gap:8px;">
        <label style="flex:1;padding:10px;border:2px solid <%= errors && errors.type ? '#c0392b' : '#403842' %>;border-radius:12px;text-align:center;cursor:pointer;transition:all 150ms;background:<%= oldInput.type === 'EXPENSE' || !oldInput.type ? '#f8f8f8' : '#fff' %>;font-weight:<%= oldInput.type === 'EXPENSE' || !oldInput.type ? '600' : '400' %>;">
          <input type="radio" name="type" value="EXPENSE" <%= oldInput.type === 'EXPENSE' || !oldInput.type ? 'checked' : '' %> style="display:none;" onchange="this.parentElement.style.background='#f8f8f8';this.parentElement.nextElementSibling.style.background='#fff';this.parentElement.style.fontWeight='600';this.parentElement.nextElementSibling.style.fontWeight='400';">
          💸 Pengeluaran
        </label>
        <label style="flex:1;padding:10px;border:2px solid <%= errors && errors.type ? '#c0392b' : '#403842' %>;border-radius:12px;text-align:center;cursor:pointer;transition:all 150ms;background:<%= oldInput.type === 'INCOME' ? '#f8f8f8' : '#fff' %>;font-weight:<%= oldInput.type === 'INCOME' ? '600' : '400' %>;">
          <input type="radio" name="type" value="INCOME" <%= oldInput.type === 'INCOME' ? 'checked' : '' %> style="display:none;" onchange="this.parentElement.style.background='#f8f8f8';this.parentElement.previousElementSibling.style.background='#fff';this.parentElement.style.fontWeight='600';this.parentElement.previousElementSibling.style.fontWeight='400';">
          💰 Pemasukan
        </label>
      </div>
      <% if (errors && errors.type) { %><span class="form-error"><%= errors.type[0] %></span><% } %>
    </div>

    <div class="form-group">
      <label for="amount" class="form-label">Jumlah (Rp)</label>
      <input type="number" id="amount" name="amount" class="form-input <%= errors && errors.amount ? 'form-input--error' : '' %>" placeholder="0" value="<%= receiptData ? receiptData.total_amount : (oldInput.amount || '') %>" required step="0.01" min="0" />
      <% if (errors && errors.amount) { %><span class="form-error"><%= errors.amount[0] %></span><% } %>
    </div>

    <div class="form-group">
      <label for="description" class="form-label">Deskripsi</label>
      <input type="text" id="description" name="description" class="form-input <%= errors && errors.description ? 'form-input--error' : '' %>" placeholder="Mis: Makan siang di warteg" value="<%= receiptData ? receiptData.store_name : (oldInput.description || '') %>" required />
      <% if (errors && errors.description) { %><span class="form-error"><%= errors.description[0] %></span><% } %>
    </div>

    <div class="form-group">
      <label for="categoryId" class="form-label">Kategori</label>
      <select id="categoryId" name="categoryId" class="form-input">
        <option value="">Pilih kategori (opsional)</option>
        <% if (typeof categories !== 'undefined') { %>
          <% categories.forEach(function(cat) { %>
            <option value="<%= cat.id %>" <%= oldInput.categoryId === cat.id ? 'selected' : '' %>><%= cat.icon || '' %> <%= cat.name %></option>
          <% }); %>
        <% } %>
      </select>
    </div>

    <div class="form-group">
      <label for="date" class="form-label">Tanggal</label>
      <input type="date" id="date" name="date" class="form-input <%= errors && errors.date ? 'form-input--error' : '' %>" value="<%= new Date().toISOString().split('T')[0] %>" required />
      <% if (errors && errors.date) { %><span class="form-error"><%= errors.date[0] %></span><% } %>
    </div>

    <div style="display:flex;gap:8px;margin-top:24px;">
      <a href="<%= basePath %>/transactions" class="btn btn-secondary">Batal</a>
      <button type="submit" class="btn btn-primary">Simpan Transaksi</button>
    </div>
  </form>
</div>
<%- include("../partials/footer") %>
