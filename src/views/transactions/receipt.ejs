<% if (!locals.isPartial) { %><%- include("../partials/header") %><% } %>
<div id="appContent" class="animate-in fade-in duration-300">
<div class="max-w-[560px]">
  <h2 class="text-2xl font-bold text-gcore-900 mb-1">Mau upload struk belanjamu?</h2>
  <p class="text-gsm text-gcore-400 mb-6">Kirim foto struknya di sini, nanti kami bantu ekstrak datanya otomatis buat kamu!</p>

  <!-- Upload Form -->
  <div id="uploadSection">
    <form id="receiptForm" class="bg-white border-2 border-gray-200 rounded-gsm p-6" novalidate>
      <div class="mb-4">
        <label class="block text-gsm font-semibold text-gcore-900 mb-1.5">Foto Struk</label>

        <!-- Dropzone (state: empty) -->
        <div id="dropzone" class="border-2 border-dashed border-gcore-400 rounded-gsm p-8 text-center cursor-pointer hover:border-gcore-accent hover:bg-gray-50 transition-colors" onclick="document.getElementById('receipt').click()">
          <div class="text-4xl text-gcore-400 mb-2"><i class="fas fa-camera"></i></div>
          <p class="text-gsm text-gcore-500">Klik atau taruh file di sini</p>
          <p class="text-gxs text-gcore-400 mt-1">Bisa pakai JPEG, PNG, atau WEBP (maksimal 5MB ya)</p>
          <input type="file" id="receipt" name="receipt" accept="image/jpeg,image/png,image/webp" required class="hidden" />
        </div>

        <!-- Preview Card (hidden until file selected) -->
        <div id="previewCard" class="hidden border-2 border-gcore-accent bg-orange-50 rounded-gsm overflow-hidden">
          <!-- Image preview -->
          <div class="relative w-full" style="max-height:220px;overflow:hidden;background:#f5f0ec;">
            <img id="previewImg" src="" alt="Preview struk" style="width:100%;max-height:220px;object-fit:contain;display:block;" />
          </div>
          <!-- File info + change button -->
          <div class="flex items-center gap-3 px-4 py-3">
            <div class="flex-shrink-0 w-9 h-9 rounded-full bg-gcore-accent flex items-center justify-center">
              <i class="fas fa-check text-white text-sm"></i>
            </div>
            <div class="flex-1 min-w-0">
              <p id="previewName" class="text-gsm font-semibold text-gcore-900 truncate"></p>
              <p id="previewSize" class="text-gxs text-gcore-400"></p>
            </div>
            <button type="button" onclick="document.getElementById('receipt').click()" class="flex-shrink-0 text-gxs text-gcore-accent font-semibold hover:underline cursor-pointer">
              Ganti Foto
            </button>
          </div>
          <!-- Hidden input still lives here so form keeps ref -->
        </div>

        <!-- Upload Progress Bar (hidden until submit) -->
        <div id="uploadProgress" class="hidden mt-3">
          <div class="flex justify-between items-center mb-1">
            <span id="progressLabel" class="text-gxs font-semibold text-gcore-900">Mengupload...</span>
            <span id="progressPct" class="text-gxs font-semibold text-gcore-accent">0%</span>
          </div>
          <div class="w-full bg-gray-200 rounded-full overflow-hidden" style="height:8px;">
            <div id="progressBar" style="height:100%;width:0%;background:linear-gradient(90deg,#ff4c00,#ff7a40);border-radius:9999px;transition:width 0.15s ease;"></div>
          </div>
        </div>

        <span id="fileError" class="hidden block text-gxs text-expense mt-1">File gambar wajib dipilih</span>
      </div>
      <button type="submit" class="w-full bg-gcore-accent text-white font-semibold py-2.5 px-5 rounded-gsm transition-colors hover:bg-gcore-700 cursor-pointer" id="parseBtn">
        <i class="fas fa-magic"></i> Ekstrak Data
      </button>
    </form>
  </div>

  <!-- Processing Card (hidden until submitted) -->
  <div id="processingCard" class="hidden bg-white border-2 border-gray-200 rounded-gsm p-6">
    <div class="flex flex-col items-center text-center py-4">
      <!-- Spinner -->
      <div class="mb-5" style="width:56px;height:56px;border:4px solid #f0ece9;border-top:4px solid #ff4c00;border-radius:50%;animation:spin 0.9s linear infinite;"></div>
      <p class="text-glg font-bold text-gcore-900 mb-2">Struk sedang diproses</p>
      <p class="text-gsm text-gcore-400 leading-relaxed mb-5">
        Kamu mau cek halaman lain dulu? Boleh kok, nanti ada notifikasi kalau sudah selesai.
      </p>
      <!-- Dots -->
      <div style="display:flex;gap:6px;">
        <span style="width:8px;height:8px;background:#ff4c00;border-radius:50%;animation:bounce 1.2s ease-in-out infinite;"></span>
        <span style="width:8px;height:8px;background:#ff4c00;border-radius:50%;animation:bounce 1.2s ease-in-out 0.2s infinite;"></span>
        <span style="width:8px;height:8px;background:#ff4c00;border-radius:50%;animation:bounce 1.2s ease-in-out 0.4s infinite;"></span>
      </div>
    </div>
    <div class="mt-4 pt-4 border-t border-gray-100 flex items-center gap-2 text-gxs text-gcore-400">
      <i class="fas fa-bell text-gcore-accent"></i>
      <span>Pantau notifikasi di pojok kanan atas</span>
    </div>
  </div>
</div>

<style>
@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}
@keyframes bounce {
  0%, 80%, 100% { transform: translateY(0); opacity: 0.4; }
  40% { transform: translateY(-8px); opacity: 1; }
}
#previewCard {
  animation: fadeSlideIn 0.25s ease;
}
#uploadProgress {
  animation: fadeSlideIn 0.2s ease;
}
@keyframes fadeSlideIn {
  from { opacity: 0; transform: translateY(-6px); }
  to   { opacity: 1; transform: translateY(0); }
}
</style>

<script data-eval="true">
(function () {
  var form = document.getElementById('receiptForm');
  var fileInput = document.getElementById('receipt');
  var fileError = document.getElementById('fileError');
  var uploadSection = document.getElementById('uploadSection');
  var processingCard = document.getElementById('processingCard');
  var dropzone = document.getElementById('dropzone');
  var previewCard = document.getElementById('previewCard');
  var previewImg = document.getElementById('previewImg');
  var previewName = document.getElementById('previewName');
  var previewSize = document.getElementById('previewSize');

  function formatBytes(bytes) {
    if (bytes < 1024) return bytes + ' B';
    if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
    return (bytes / (1024 * 1024)).toFixed(2) + ' MB';
  }

  function showPreview(file) {
    if (!file) return;
    // Show preview card, hide dropzone
    dropzone.classList.add('hidden');
    previewCard.classList.remove('hidden');

    previewName.textContent = file.name;
    previewSize.textContent = formatBytes(file.size);

    var reader = new FileReader();
    reader.onload = function (e) {
      previewImg.src = e.target.result;
    };
    reader.readAsDataURL(file);

    fileError.classList.add('hidden');
  }

  // Show preview on file select
  fileInput.addEventListener('change', function () {
    if (this.files && this.files[0]) {
      showPreview(this.files[0]);
    } else {
      // Reset to empty dropzone
      dropzone.classList.remove('hidden');
      previewCard.classList.add('hidden');
    }
  });

  // AJAX submit with upload progress
  var uploadProgress = document.getElementById('uploadProgress');
  var progressBar = document.getElementById('progressBar');
  var progressPct = document.getElementById('progressPct');
  var progressLabel = document.getElementById('progressLabel');

  function resetUploadUI() {
    uploadProgress.classList.add('hidden');
    progressBar.style.width = '0%';
    progressPct.textContent = '0%';
    progressLabel.textContent = 'Mengupload...';
  }

  form.addEventListener('submit', function (e) {
    e.preventDefault();

    if (!fileInput.files || fileInput.files.length === 0) {
      fileError.classList.remove('hidden');
      return;
    }

    var btn = document.getElementById('parseBtn');
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Mengirim...';
    fileError.classList.add('hidden');

    // Show progress bar
    resetUploadUI();
    uploadProgress.classList.remove('hidden');

    var formData = new FormData();
    formData.append('receipt', fileInput.files[0]);

    var xhr = new XMLHttpRequest();

    // Upload progress
    xhr.upload.addEventListener('progress', function (e) {
      if (e.lengthComputable) {
        var pct = Math.round((e.loaded / e.total) * 100);
        progressBar.style.width = pct + '%';
        progressPct.textContent = pct + '%';
        if (pct >= 100) {
          progressLabel.textContent = 'Menunggu server...';
        }
      }
    });

    xhr.upload.addEventListener('load', function () {
      progressBar.style.width = '100%';
      progressPct.textContent = '100%';
      progressLabel.textContent = 'Menunggu server...';
    });

    xhr.addEventListener('load', function () {
      uploadProgress.classList.add('hidden');
      try {
        var data = JSON.parse(xhr.responseText);
        if (data.ok) {
          uploadSection.classList.add('hidden');
          processingCard.classList.remove('hidden');
        } else {
          btn.disabled = false;
          btn.innerHTML = '<i class="fas fa-magic"></i> Ekstrak Data';
          fileError.textContent = data.error || 'Terjadi kesalahan, coba lagi.';
          fileError.classList.remove('hidden');
        }
      } catch (_) {
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-magic"></i> Ekstrak Data';
        fileError.textContent = 'Respons server tidak valid, coba lagi.';
        fileError.classList.remove('hidden');
      }
    });

    xhr.addEventListener('error', function () {
      uploadProgress.classList.add('hidden');
      btn.disabled = false;
      btn.innerHTML = '<i class="fas fa-magic"></i> Ekstrak Data';
      fileError.textContent = 'Gagal terhubung ke server, coba lagi.';
      fileError.classList.remove('hidden');
    });

    xhr.addEventListener('abort', function () {
      uploadProgress.classList.add('hidden');
      btn.disabled = false;
      btn.innerHTML = '<i class="fas fa-magic"></i> Ekstrak Data';
    });

    xhr.open('POST', '<%= basePath %>/transactions/receipt/parse');
    xhr.send(formData);
  });

  // Drag & drop
  dropzone.addEventListener('dragover', function (e) { e.preventDefault(); this.style.borderColor = '#ff4c00'; this.style.background = '#fafafa'; });
  dropzone.addEventListener('dragleave', function (e) { e.preventDefault(); this.style.borderColor = ''; this.style.background = ''; });
  dropzone.addEventListener('drop', function (e) {
    e.preventDefault(); this.style.borderColor = ''; this.style.background = '';
    var file = e.dataTransfer.files[0];
    if (file) {
      // Transfer file to the input via DataTransfer
      var dt = new DataTransfer();
      dt.items.add(file);
      fileInput.files = dt.files;
      showPreview(file);
    }
  });
})();
</script>

</div>
<% if (!locals.isPartial) { %><%- include("../partials/footer") %><% } %>
