<%- include("../partials/header") %>

<div class="max-w-[560px]">
  <h2 class="text-2xl font-bold text-gcore-900 mb-1">Upload Struk</h2>
  <p class="text-gsm text-gcore-400 mb-6">Foto struk belanja, kami akan ekstrak datanya secara otomatis</p>

  <form action="<%= basePath %>/transactions/receipt/parse" method="POST" enctype="multipart/form-data" class="bg-white border-2 border-gray-200 rounded-gsm p-6" novalidate>
    <div class="mb-4">
      <label class="block text-gsm font-semibold text-gcore-900 mb-1.5">Foto Struk</label>
      <div id="dropzone" class="border-2 border-dashed border-gcore-400 rounded-gsm p-8 text-center cursor-pointer hover:border-gcore-accent hover:bg-gray-50 transition-colors" onclick="document.getElementById('receipt').click()">
        <div class="text-4xl text-gcore-400 mb-2"><i class="fas fa-camera"></i></div>
        <p class="text-gsm text-gcore-500">Klik atau taruh file di sini</p>
        <p class="text-gxs text-gcore-400 mt-1">JPEG, PNG, WEBP &mdash; Maks 5MB</p>
        <input type="file" id="receipt" name="receipt" accept="image/jpeg,image/png,image/webp" required class="hidden" onchange="document.getElementById('filename').textContent=this.files[0].name" />
        <p id="filename" class="text-gxs font-semibold text-gcore-900 mt-2"></p>
      </div>
      <% if (errors && errors.receipt) { %><span class="block text-gxs text-expense mt-1"><%= errors.receipt %></span><% } %>
    </div>
    <button type="submit" class="w-full bg-gcore-accent text-white font-semibold py-2.5 px-5 rounded-gsm transition-colors hover:bg-gcore-700 cursor-pointer" id="parseBtn">
      <i class="fas fa-magic"></i> Ekstrak Data
    </button>
  </form>
</div>

<script>
document.getElementById("parseBtn").addEventListener("click", function() {
  this.disabled = true;
  this.innerHTML = "<i class=\"fas fa-spinner fa-spin\"></i> Memproses...";
});
document.getElementById("dropzone").addEventListener("dragover", function(e) { e.preventDefault(); this.style.borderColor="#ff4c00"; this.style.background="#fafafa"; });
document.getElementById("dropzone").addEventListener("dragleave", function(e) { e.preventDefault(); this.style.borderColor=""; this.style.background=""; });
document.getElementById("dropzone").addEventListener("drop", function(e) {
  e.preventDefault(); this.style.borderColor=""; this.style.background="";
  var file = e.dataTransfer.files[0];
  if (file) { document.getElementById("receipt").files = e.dataTransfer.files; document.getElementById("filename").textContent = file.name; }
});
</script>

<%- include("../partials/footer") %>
