<%- include("../partials/header") %>

<div class="max-w-[560px]">
  <h2 class="text-2xl font-bold text-gcore-900 mb-1">Upload Struk</h2>
  <p class="text-gsm text-gcore-400 mb-6">Foto struk belanja, kami akan ekstrak datanya secara otomatis</p>

  <form action="<%= basePath %>/transactions/receipt/parse" method="POST" enctype="multipart/form-data" class="bg-white border-2 border-gray-200 rounded-gsm p-6" novalidate id="receiptForm">
    <div class="mb-4">
      <label class="block text-gsm font-semibold text-gcore-900 mb-1.5">Foto Struk</label>
      <div id="dropzone" class="border-2 border-dashed border-gcore-400 rounded-gsm p-8 text-center cursor-pointer hover:border-gcore-accent hover:bg-gray-50 transition-colors" onclick="document.getElementById('receipt').click()">
        <div class="text-4xl text-gcore-400 mb-2"><i class="fas fa-camera"></i></div>
        <p class="text-gsm text-gcore-500">Klik atau taruh file di sini</p>
        <p class="text-gxs text-gcore-400 mt-1">JPEG, PNG, WEBP &mdash; Maks 5MB</p>
        <input type="file" id="receipt" name="receipt" accept="image/jpeg,image/png,image/webp" required class="hidden" onchange="document.getElementById('filename').textContent=this.files[0].name" />
        <p id="filename" class="text-gxs font-semibold text-gcore-900 mt-2"></p>
      </div>
      <% if (errors && errors.receipt) { %><span class="block text-gxs text-expense mt-1"><%= errors.receipt %></span><% } %>
    </div>
    <button type="submit" class="w-full bg-gcore-accent text-white font-semibold py-2.5 px-5 rounded-gsm transition-colors hover:bg-gcore-700 cursor-pointer" id="parseBtn">
      <i class="fas fa-magic"></i> Ekstrak Data
    </button>
  </form>
</div>

<!-- Processing Overlay -->
<div id="processingOverlay" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.65); z-index:9999; backdrop-filter:blur(4px); -webkit-backdrop-filter:blur(4px);">
  <div style="position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); background:#fff; border-radius:16px; padding:36px 32px; max-width:340px; width:90%; text-align:center; box-shadow:0 20px 60px rgba(0,0,0,0.3);">
    <!-- Spinner -->
    <div style="display:flex; justify-content:center; margin-bottom:20px;">
      <div style="width:52px; height:52px; border:4px solid #f0ece9; border-top:4px solid #ff4c00; border-radius:50%; animation:spin 0.9s linear infinite;"></div>
    </div>
    <p style="font-size:16px; font-weight:700; color:#150c18; margin:0 0 8px;">Struk sedang diproses</p>
    <p style="font-size:13px; color:#9CA3AF; margin:0 0 20px; line-height:1.6;">AI sedang membaca dan menganalisis struk Anda.<br>Mohon tunggu sebentar…</p>
    <div style="display:flex; gap:6px; justify-content:center; margin-top:4px;">
      <span style="width:8px; height:8px; background:#ff4c00; border-radius:50%; animation:bounce 1.2s ease-in-out infinite;"></span>
      <span style="width:8px; height:8px; background:#ff4c00; border-radius:50%; animation:bounce 1.2s ease-in-out 0.2s infinite;"></span>
      <span style="width:8px; height:8px; background:#ff4c00; border-radius:50%; animation:bounce 1.2s ease-in-out 0.4s infinite;"></span>
    </div>
  </div>
</div>

<style>
@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}
@keyframes bounce {
  0%, 80%, 100% { transform: translateY(0); opacity: 0.4; }
  40% { transform: translateY(-8px); opacity: 1; }
}
</style>

<script>
document.getElementById("receiptForm").addEventListener("submit", function(e) {
  var fileInput = document.getElementById("receipt");
  if (!fileInput.files || fileInput.files.length === 0) return;

  // Show processing overlay
  document.getElementById("processingOverlay").style.display = "block";

  // Disable submit button to prevent double-submit
  var btn = document.getElementById("parseBtn");
  btn.disabled = true;
  btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Memproses...';
});

document.getElementById("dropzone").addEventListener("dragover", function(e) { e.preventDefault(); this.style.borderColor="#ff4c00"; this.style.background="#fafafa"; });
document.getElementById("dropzone").addEventListener("dragleave", function(e) { e.preventDefault(); this.style.borderColor=""; this.style.background=""; });
document.getElementById("dropzone").addEventListener("drop", function(e) {
  e.preventDefault(); this.style.borderColor=""; this.style.background="";
  var file = e.dataTransfer.files[0];
  if (file) { document.getElementById("receipt").files = e.dataTransfer.files; document.getElementById("filename").textContent = file.name; }
});
</script>

<%- include("../partials/footer") %>
